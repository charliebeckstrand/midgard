{
	"name": "auth",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./config": {
			"types": "./src/config.ts",
			"import": "./dist/config.js",
			"default": "./dist/config.js"
		},
		"./proxy": {
			"types": "./src/proxy.ts",
			"import": "./dist/proxy.js",
			"default": "./dist/proxy.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:changed": "vitest run",
		"test:related": "vitest related --run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"peerDependencies": {
		"next": "^15.0.0 || ^16.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"next": "catalog:",
		"react": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
