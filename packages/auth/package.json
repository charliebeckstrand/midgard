{
	"name": "auth",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./app-config": {
			"types": "./src/app-config.ts",
			"import": "./dist/app-config.js",
			"default": "./dist/app-config.js"
		},
		"./config": {
			"types": "./src/config.ts",
			"import": "./dist/config.js",
			"default": "./dist/config.js"
		},
		"./proxy": {
			"types": "./src/proxy.ts",
			"import": "./dist/proxy.js",
			"default": "./dist/proxy.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"check-types": "tsc --noEmit",
		"openapi": "openapi-typescript https://raw.githubusercontent.com/charliebeckstrand/asgard/main/services/bifrost/openapi.json -o src/openapi.d.ts && biome format --write src/openapi.d.ts",
		"test": "LANG=en-US vitest run",
		"test:changed": "LANG=en-US vitest run",
		"test:related": "LANG=en-US vitest related --run --passWithNoTests=false"
	},
	"peerDependencies": {
		"next": "^16.3.3",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"next": "catalog:",
		"openapi-typescript": "catalog:",
		"react": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:typescript6",
		"vitest": "catalog:"
	},
	"dependencies": {
		"openapi-fetch": "catalog:"
	}
}
