{
	"name": "shared",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./auth": {
			"types": "./src/auth/index.ts",
			"import": "./dist/auth.js",
			"default": "./dist/auth.js"
		},
		"./theme.css": "./src/theme.css",
		"./globals.css": "./src/globals.css"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"check-types": "tsc --noEmit",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write ."
	},
	"dependencies": {
		"ui": "workspace:*"
	},
	"peerDependencies": {
		"next": "^15.0.0 || ^16.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"next": "catalog:",
		"react": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:"
	}
}
