{
	"name": "shared",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		"./auth": {
			"types": "./src/auth/index.ts",
			"default": "./src/auth/index.ts"
		},
		"./providers": {
			"types": "./src/providers/index.ts",
			"default": "./src/providers/index.ts"
		},
		"./mimir": {
			"types": "./src/mimir/index.ts",
			"default": "./src/mimir/index.ts"
		},
		"./globals.css": "./src/globals.css"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"openapi": "openapi-typescript https://raw.githubusercontent.com/charliebeckstrand/asgard/main/services/mimir/openapi.json -o src/mimir/openapi.d.ts && biome format --write src/mimir/openapi.d.ts",
		"test": "vitest run",
		"test:changed": "vitest run",
		"test:related": "vitest related --run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@simplewebauthn/browser": "catalog:",
		"auth": "workspace:*",
		"lucide-react": "catalog:",
		"openapi-fetch": "catalog:",
		"ui": "workspace:*"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.0.0",
		"next": "^15.0.0 || ^16.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@tanstack/react-query": "catalog:",
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"next": "catalog:",
		"openapi-typescript": "^7.13.0",
		"react": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
