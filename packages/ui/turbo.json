{
	"$schema": "https://v2-11-7.turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"test": {
			"inputs": [
				"src/**",
				"fonts/**",
				"scripts/fonts.ts",
				"docs/*.md",
				"REFERENCE.md",
				"vitest.config.ts",
				"vitest.base.ts",
				"vitest.browser.config.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"package.json"
			]
		},
		"test:browser": {
			"inputs": ["$TURBO_EXTENDS$", "vitest.base.ts"]
		},
		"test:compiler": {
			"inputs": ["$TURBO_EXTENDS$", "vitest.base.ts"]
		},
		"test:workspace": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"docs/*.md",
				"REFERENCE.md",
				"vitest.config.ts",
				"vitest.base.ts",
				"package.json",
				"$TURBO_ROOT$/{CLAUDE,CONVENTIONS,CADENCE,STE,REFERENCE}.md",
				"$TURBO_ROOT$/biome.json",
				"$TURBO_ROOT$/.biome/plugins/**",
				"$TURBO_ROOT$/apps/**/*.{ts,tsx,mts,cts}",
				"!$TURBO_ROOT$/apps/*/.next/**",
				"!$TURBO_ROOT$/apps/*/node_modules/**",
				"$TURBO_ROOT$/packages/*/src/**"
			]
		}
	}
}
