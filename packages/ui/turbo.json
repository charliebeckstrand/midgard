{
	"$schema": "https://v2-11-7.turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"test": {
			"inputs": [
				"src/**",
				"fonts/**",
				"scripts/fonts/build.ts",
				"docs/*.md",
				"REFERENCE.md",
				"vitest.config.ts",
				"vitest.docs.config.ts",
				"vitest.base.ts",
				"vitest.browser.config.ts",
				"$TURBO_ROOT$/vitest.shared.mts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"package.json"
			]
		},
		"test:workspace": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"docs/*.md",
				"REFERENCE.md",
				"vitest.config.ts",
				"vitest.base.ts",
				"vitest.compiler.config.ts",
				"vitest.compiler.preset.ts",
				"$TURBO_ROOT$/vitest.shared.mts",
				"package.json",
				"$TURBO_ROOT$/{CLAUDE,CONVENTIONS,STE}.md",
				"$TURBO_ROOT$/.github/workflows/ci.yml",
				"$TURBO_ROOT$/.claude/agents/*.md",
				"$TURBO_ROOT$/{Dockerfile,Dockerfile.*,package.json,pnpm-lock.yaml}",
				"$TURBO_ROOT$/biome.json",
				"$TURBO_ROOT$/.biome/plugins/**",
				"$TURBO_ROOT$/apps/**/*.{ts,tsx,mts,cts,md}",
				"!$TURBO_ROOT$/apps/*/.next/**",
				"!$TURBO_ROOT$/apps/*/node_modules/**",
				"$TURBO_ROOT$/packages/*/src/**",
				"$TURBO_ROOT$/packages/{auth,shared}/*.{ts,md}",
				"$TURBO_ROOT$/packages/shared/scripts/**"
			]
		},
		"test:browser": {
			"dependsOn": ["^build"],
			"env": ["DENSITY_ENGINES"],
			"passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
			"inputs": [
				"src/**",
				"vitest.browser.config.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"vitest.base.ts",
				"$TURBO_ROOT$/vitest.shared.mts"
			]
		},
		"test:compiler": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"vitest.config.ts",
				"vitest.compiler.config.ts",
				"vitest.compiler.preset.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"package.json",
				"vitest.base.ts",
				"$TURBO_ROOT$/vitest.shared.mts",
				"vitest.docs.config.ts",
				"vitest.docs-compiler.config.ts"
			]
		},
		"bench:smoke": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"vitest.bench.config.ts",
				"vitest.base.ts",
				"$TURBO_ROOT$/vitest.shared.mts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json"
			]
		},
		"bench:browser:smoke": {
			"dependsOn": ["^build"],
			"passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
			"inputs": [
				"src/**",
				"vitest.bench.browser.config.ts",
				"vitest.browser.config.ts",
				"vitest.base.ts",
				"$TURBO_ROOT$/vitest.shared.mts",
				"styles/tailwind.css",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json"
			]
		},
		"docs:build": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"!src/**/__tests__/**",
				"!src/__benchmarks__/**",
				"styles/tailwind.css",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json"
			],
			"outputs": ["src/docs/dist/**"]
		},
		"test:docs-build": {
			"dependsOn": ["docs:build"],
			"inputs": [
				"src/docs/dist/**",
				"src/__tests__/docs-build/**",
				"scripts/docs/server.ts",
				"vitest.docs-build.config.ts",
				"vitest.base.ts",
				"$TURBO_ROOT$/vitest.shared.mts"
			]
		},
		"docs:bench": {
			"dependsOn": ["docs:build"],
			"cache": false
		}
	}
}
