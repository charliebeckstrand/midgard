{
	"name": "ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		"./core": {
			"types": "./src/core/index.ts",
			"default": "./src/core/index.ts"
		},
		"./hooks": {
			"types": "./src/hooks/index.ts",
			"default": "./src/hooks/index.ts"
		},
		"./layouts": {
			"types": "./src/layouts/index.ts",
			"default": "./src/layouts/index.ts"
		},
		"./primitives/*": {
			"types": "./src/primitives/*/index.ts",
			"default": "./src/primitives/*/index.ts"
		},
		"./providers/*": {
			"types": "./src/providers/*/index.ts",
			"default": "./src/providers/*/index.ts"
		},
		"./modules/*": {
			"types": "./src/modules/*/index.ts",
			"default": "./src/modules/*/index.ts"
		},
		"./*": [
			{
				"types": "./src/components/*/index.ts",
				"default": "./src/components/*/index.ts"
			},
			{
				"types": "./src/modules/*/index.ts",
				"default": "./src/modules/*/index.ts"
			}
		]
	},
	"scripts": {
		"build": "tsup",
		"dev": "trap 'kill 0' EXIT; tsup --watch --no-dts & vite --config vite.docs.config.ts & wait",
		"docs": "vite --config vite.docs.config.ts",
		"docs:build": "vite build --config vite.docs.config.ts",
		"docs:analyze": "ANALYZE=1 vite build --config vite.docs.config.ts",
		"docs:preview": "vite preview --config vite.docs.config.ts --port 3456",
		"test": "LANG=en-US vitest run",
		"test:browser": "LANG=en-US vitest run --config vitest.browser.config.ts",
		"test:compiler": "LANG=en-US vitest run --config vitest.compiler.config.ts --project unit --project pure --project integration --project skips",
		"test:a11y": "LANG=en-US vitest run src/__tests__/a11y",
		"test:watch": "LANG=en-US vitest",
		"test:coverage": "LANG=en-US vitest run --coverage",
		"test:changed": "export LANG=en-US && base=$(git merge-base HEAD origin/main) && vitest run --project boundary && vitest run --passWithNoTests --changed=\"$base\"",
		"test:related": "LANG=en-US vitest related --run",
		"bench": "vitest bench --run --config vitest.bench.config.ts",
		"bench:browser": "vitest bench --run --config vitest.bench.browser.config.ts",
		"bench:browser:compiler": "vitest bench --run --config vitest.bench.browser.compiler.config.ts",
		"bench:docs": "vitest bench --run --config vitest.bench.docs.config.ts",
		"bench:docs:vite": "tsx src/__benchmarks__/docs/vite-metrics.ts",
		"bundle:budget": "tsx src/__benchmarks__/docs/bundle-budget.ts",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.docs.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@floating-ui/react": "^0.27.19",
		"@internationalized/date": "^3.10.0",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/react-virtual": "^3.13.23",
		"@types/d3-geo": "catalog:",
		"@types/topojson-client": "catalog:",
		"card-validator": "^10.0.4",
		"clsx": "^2.0.0",
		"d3-geo": "catalog:",
		"fflate": "^0.8.3",
		"lucide-react": "catalog:",
		"marked": "^18.0.5",
		"motion": "^12.0.0",
		"pdfjs-dist": "^6.2.108",
		"shiki": "^3.23.0",
		"tailwind-merge": "^3.5.0",
		"tinykeys": "^4.0.0",
		"topojson-client": "catalog:"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fast-check/vitest": "^0.5.0",
		"@mui/material": "^9.2.0",
		"@mui/x-data-grid": "^9.9.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/react-query": "catalog:",
		"@tanstack/table-core": "^9.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/babel__core": "^7.20.5",
		"@types/jest-axe": "^3.5.9",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"ag-charts-community": "^14.0.0",
		"ag-grid-community": "^36.0.0",
		"babel-plugin-react-compiler": "catalog:",
		"echarts": "^6.1.0",
		"highcharts": "^13.0.0",
		"jest-axe": "^10.0.0",
		"jsdom": "^29.0.2",
		"playwright": "1.56.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"rollup-plugin-visualizer": "^6.0.0",
		"tailwindcss": "catalog:",
		"ts-morph": "^28.0.0",
		"tsup": "catalog:",
		"tsx": "^4.19.0",
		"typescript": "catalog:",
		"us-atlas": "catalog:",
		"vite": "^8.0.16",
		"vitest": "catalog:",
		"world-atlas": "catalog:"
	}
}
