{
	"name": "ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		"./core": {
			"types": "./src/core/index.ts",
			"default": "./src/core/index.ts"
		},
		"./hooks": {
			"types": "./src/hooks/index.ts",
			"default": "./src/hooks/index.ts"
		},
		"./layouts": {
			"types": "./src/layouts/index.ts",
			"default": "./src/layouts/index.ts"
		},
		"./primitives/*": {
			"types": "./src/primitives/*/index.ts",
			"default": "./src/primitives/*/index.ts"
		},
		"./providers/*": {
			"types": "./src/providers/*/index.ts",
			"default": "./src/providers/*/index.ts"
		},
		"./modules/*": {
			"types": "./src/modules/*/index.ts",
			"default": "./src/modules/*/index.ts"
		},
		"./structure/*": {
			"types": "./src/structure/*/index.ts",
			"default": "./src/structure/*/index.ts"
		},
		"./box": {
			"types": "./src/structure/box/index.ts",
			"default": "./src/structure/box/index.ts"
		},
		"./columns": {
			"types": "./src/structure/columns/index.ts",
			"default": "./src/structure/columns/index.ts"
		},
		"./container": {
			"types": "./src/structure/container/index.ts",
			"default": "./src/structure/container/index.ts"
		},
		"./flex": {
			"types": "./src/structure/flex/index.ts",
			"default": "./src/structure/flex/index.ts"
		},
		"./spacer": {
			"types": "./src/structure/spacer/index.ts",
			"default": "./src/structure/spacer/index.ts"
		},
		"./split": {
			"types": "./src/structure/split/index.ts",
			"default": "./src/structure/split/index.ts"
		},
		"./stack": {
			"types": "./src/structure/stack/index.ts",
			"default": "./src/structure/stack/index.ts"
		},
		"./chart": {
			"types": "./src/modules/chart/index.ts",
			"default": "./src/modules/chart/index.ts"
		},
		"./chat": {
			"types": "./src/modules/chat/index.ts",
			"default": "./src/modules/chat/index.ts"
		},
		"./dashboard": {
			"types": "./src/modules/dashboard/index.ts",
			"default": "./src/modules/dashboard/index.ts"
		},
		"./grid": {
			"types": "./src/modules/grid/index.ts",
			"default": "./src/modules/grid/index.ts"
		},
		"./map": {
			"types": "./src/modules/map/index.ts",
			"default": "./src/modules/map/index.ts"
		},
		"./query": {
			"types": "./src/modules/query/index.ts",
			"default": "./src/modules/query/index.ts"
		},
		"./tailwind.css": "./tailwind.css",
		"./*": {
			"types": "./src/components/*/index.ts",
			"default": "./src/components/*/index.ts"
		}
	},
	"scripts": {
		"build:dist": "tsup",
		"dev": "react-router dev src/docs",
		"fonts": "tsx scripts/fonts.ts",
		"docs:build": "react-router build src/docs",
		"docs:preview": "tsx scripts/docs-server.ts",
		"docs:bench": "tsx scripts/docs-bench.ts",
		"test": "LANG=en-US vitest run --project unit --project pure --project boundary --project integration --project geometry",
		"test:workspace": "LANG=en-US vitest run --project workspace",
		"test:browser": "LANG=en-US vitest run --config vitest.browser.config.ts",
		"test:docs-build": "vitest run --config vitest.docs-build.config.ts",
		"test:geometry": "export LANG=en-US && vitest run --project geometry && vitest run --config vitest.browser.config.ts --project geometry",
		"test:compiler": "LANG=en-US vitest run --config vitest.compiler.config.ts --project unit --project pure --project integration --project geometry --project skips",
		"test:a11y": "LANG=en-US vitest run src/__tests__/a11y",
		"test:watch": "LANG=en-US vitest",
		"test:coverage": "export LANG=en-US && vitest run --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage/jsdom && vitest run --config vitest.browser.config.ts --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage/browser && tsx scripts/merge-coverage.ts",
		"test:changed": "export LANG=en-US && base=$(git merge-base HEAD origin/main) && vitest run --project boundary --project workspace && vitest run --passWithNoTests --changed=\"$base\"",
		"test:related": "LANG=en-US vitest related --run",
		"bench": "vitest bench --run --config vitest.bench.config.ts",
		"bench:browser": "vitest bench --run --config vitest.bench.browser.config.ts",
		"bench:browser:compiler": "vitest bench --run --config vitest.bench.browser.compiler.config.ts",
		"visual": "tsx scripts/visual.ts",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p src/docs/tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@floating-ui/react": "^0.27.20",
		"@internationalized/date": "^3.10.0",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/virtual-core": "3.17.11",
		"@types/d3-geo": "catalog:",
		"@types/topojson-client": "catalog:",
		"card-validator": "^10.0.4",
		"clsx": "^2.0.0",
		"d3-geo": "catalog:",
		"fflate": "^0.8.3",
		"lucide-react": "catalog:",
		"marked": "^18.1.0",
		"motion": "^14.0.0",
		"pdfjs-dist": "^6.4.299",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tinykeys": "^4.0.0",
		"topojson-client": "catalog:"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@capsizecss/core": "^4.1.3",
		"@capsizecss/metrics": "^4.3.0",
		"@capsizecss/unpack": "^4.0.1",
		"@fast-check/vitest": "^0.5.0",
		"@percy/cli": "^1.32.11",
		"@percy/playwright": "^1.1.2",
		"@react-router/dev": "^8.4.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@rolldown/pluginutils": "^1.0.1",
		"@tailwindcss/node": "^4.3.0",
		"@tailwindcss/oxide": "^4.3.0",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/table-core": "^9.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/babel__core": "^7.20.5",
		"@types/istanbul-lib-coverage": "^2.0.6",
		"@types/istanbul-lib-report": "^3.0.3",
		"@types/istanbul-reports": "^3.0.4",
		"@types/jest-axe": "^3.5.9",
		"@types/jsdom": "^28.0.3",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"babel-plugin-react-compiler": "catalog:",
		"fontkitten": "^1.0.3",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"jest-axe": "^10.0.0",
		"jsdom": "^29.0.2",
		"playwright": "1.56.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router": "^8.4.0",
		"subset-font": "^2.9.0",
		"tailwindcss": "catalog:",
		"tsup": "catalog:",
		"tsx": "^4.19.0",
		"typescript": "7.0.2",
		"us-atlas": "catalog:",
		"vite": "^8.3.2",
		"vitest": "catalog:",
		"world-atlas": "catalog:"
	}
}
