{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Excluding the test and benchmark trees moves the inferred common source
		// directory to `src`, which would relocate every emitted declaration.
		// Pinning `rootDir` to the package root keeps the `dist/src/…` layout the
		// build had before.
		"rootDir": ".",
		"tsBuildInfoFile": ".tsbuildinfo/build.tsbuildinfo"
	},
	"include": ["src"],
	"exclude": ["src/docs", "src/__tests__", "src/__benchmarks__"]
}
