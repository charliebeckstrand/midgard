{
	"name": "places",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --port 3001 --turbopack",
		"build": "next build",
		"start": "next start --port 3001",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:related": "vitest related --run",
		"test:changed": "base=$(git merge-base HEAD origin/main) && vitest run --passWithNoTests --changed=\"$base\""
	},
	"dependencies": {
		"@tanstack/react-query": "catalog:",
		"d3-geo": "catalog:",
		"lucide-react": "catalog:",
		"next": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shared": "workspace:*",
		"topojson-client": "catalog:",
		"ui": "workspace:*",
		"us-atlas": "catalog:",
		"world-atlas": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@tailwindcss/postcss": "catalog:",
		"@types/d3-geo": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/topojson-client": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
