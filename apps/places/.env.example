# URL of the bifrost gateway. The places app sends it each /auth/* and /api/* request
# that the route handlers of the app do not serve.
# Required for `next build` and `next start`, because the build writes it into the
# rewrites. Defaults to http://localhost:4000 in development. In production, set it to
# https://auth.ivoryimage.dev, the gateway that serves /auth/* and /api/* at its root.
BIFROST_URL=http://localhost:4000

# Secret that the gateway requires before it uses the browser address that the
# proxy sends in `x-client-ip`. The gateway holds the same value. Required in
# production. Not set in development, where the gateway uses the address of the
# connection.
CLIENT_IP_SECRET=

# Connection URL of the places database, where the stores keep the places and the
# visits of each user. Required in production, where App Platform sets it from the
# bound cluster. Not set in development, where the stores keep JSON files under
# `.data/users`. The `migrate` job applies `db/schema.sql` to this database.
DATABASE_URL=

# PEM certificate of the CA of the database server. With it, TLS verifies the
# server. App Platform sets it from the bound cluster.
DATABASE_CA_CERT=
