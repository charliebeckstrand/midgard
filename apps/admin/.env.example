# URL of the bifrost gateway that the admin app proxies auth and API requests to.
# Required for `next build` and `next start`, because the build writes it into the
# rewrites. Defaults to http://localhost:4000 in development. In production, set it to
# https://auth.ivoryimage.dev, the gateway that serves /auth/* and /api/* at its root.
BIFROST_URL=http://localhost:4000

# Secret that the gateway requires before it uses the browser address that the
# proxy sends in `x-client-ip`. The gateway holds the same value. Required in
# production. Not set in development, where the gateway uses the address of the
# connection.
CLIENT_IP_SECRET=
