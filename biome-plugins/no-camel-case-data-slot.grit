language js

// The slot override is the native `data-slot` attribute everywhere: DOM
// attribute, component prop, and call site. One token stays greppable across
// the package.
//
// The plugin matches syntax, not file text. It matches the identifier in a
// prop, a key, a type member, or a member access. It also matches the string or
// the template literal in a computed access. A mention in a comment is not a
// violation, so this file can name the token plainly.
//
// Reach is the whole package source, tests included, because the convention
// binds the call sites too.
or {
	`dataSlot`,
	`"dataSlot"`,
	JsTemplateChunkElement() as $chunk where { $chunk <: r"dataSlot" }
} where {
	register_diagnostic(
		span = $match,
		message = "expose the slot as the native `data-slot` attribute, never as a camelCase prop"
	)
}
