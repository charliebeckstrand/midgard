language js

// Every context in this package goes through `core/createContext`, which
// serves the required mode (it throws when a provider is missing) and the
// optional mode (it returns a default). A direct import from React bypasses
// both.
//
// `create-context-boundary.test.ts` held this as a `node:fs` scan over source
// text until Biome's GritQL learned to match an import clause of more than one
// name. The alternation below matches the alias form too: the scan it replaces
// keyed on the token anywhere inside the braces, so `createContext as mine`
// was a violation there and stays one here.
//
// Reach is the `includes` beside this plugin in `biome.json` — the package
// source, minus each test and benchmark tree at any depth, minus the one
// sanctioned file — which reproduces what `walkSource` skipped.
`import $clause from 'react'` where {
	$clause <: contains or { `createContext`, `createContext as $_` }
} where {
	register_diagnostic(
		span = $clause,
		message = "take createContext from `ui/core`, not from React: the local helper carries the required and optional modes this package's contexts rely on"
	)
}
