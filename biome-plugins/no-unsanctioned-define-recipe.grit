language js

// `defineRecipe` is the kata surface's own tool. A kata that matches no
// archetype calls it directly; a kata that matches one routes through its
// katakana applicator; a layout keeps its variants beside itself. Anywhere
// else, a recipe defined in place escapes the layering the package reads its
// styling through.
//
// `kata-boundary.test.ts` held this as a `node:fs` scan over source text. The
// specifier is matched by regex rather than by literal, because the scan it
// replaces accepted any path ending in `core/recipe` — a deep relative path, a
// package path, either quote style.
//
// The sanctioned files are the `includes` beside this plugin in `biome.json`:
// the kata surface, the katakana applicators, and the per-layout variants file.
`import $clause from $src` where {
	$clause <: contains or { `defineRecipe`, `defineRecipe as $_` },
	$src <: r"['\"].*core/recipe['\"]"
} => . where {
	register_diagnostic(
		span = $clause,
		message = "defineRecipe belongs to the kata surface: call it from `recipes/kata`, route through `recipes/katakana`, or keep it in the layout's own `variants.ts`"
	)
}
