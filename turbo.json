{
	"$schema": "https://v2-11-7.turborepo.dev/schema.json",
	"agentGuidance": false,
	"globalDependencies": [".node-version"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["BIFROST_URL"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!src/**/__tests__/**",
				"!*.md",
				"$TURBO_ROOT$/.browserslistrc",
				"$TURBO_ROOT$/postcss.config.mjs",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/tsconfig.nextjs.json",
				"$TURBO_ROOT$/vitest.shared.mts"
			],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"transit": {
			"dependsOn": ["^transit"],
			"inputs": ["src/**", "scripts/**", "!src/**/__tests__/**", "package.json"]
		},
		"check-types": {
			"dependsOn": ["transit"],
			"inputs": [
				"src/**",
				"app/**",
				"scripts/**",
				"*.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/tsconfig.nextjs.json"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"app/**",
				"scripts/**",
				"*.ts",
				"$TURBO_ROOT$/vitest.shared.mts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/tsconfig.nextjs.json",
				"package.json"
			]
		},
		"test:changed": {
			"dependsOn": ["^build"],
			"env": ["TURBO_SCM_BASE"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/{apps,packages}/**/{package.json,vite.config.*,vitest.config.*}",
				"!$TURBO_ROOT$/**/node_modules/**",
				"!$TURBO_ROOT$/apps/*/.next/**",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/tsconfig.nextjs.json",
				"$TURBO_ROOT$/vitest.shared.mts"
			]
		},
		"//#lint": {},
		"//#knip": {}
	}
}
