{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["BIFROST_URL"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/postcss.config.mjs"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["src/**", "!src/**/__tests__/**", "package.json"]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "inputs": [
        "src/**",
        "app/**",
        "*.ts",
        "tsconfig.json",
        "tsconfig.scripts.json",
        "tsconfig.docs.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.nextjs.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs:build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "vite.docs.config.ts",
        "tsconfig.json",
        "tsconfig.docs.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["src/docs/dist/**"]
    },
    "bundle:budget": {
      "dependsOn": ["docs:build"],
      "inputs": ["src/docs/dist/**", "src/__benchmarks__/docs/bundle-*.ts"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "app/**",
        "*.ts",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/.biome/plugins/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "app/**",
        "vitest.config.ts",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "docs/*.md",
        "package.json"
      ]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "vitest.browser.config.ts",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "test:changed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#knip": {
      "inputs": [
        "knip.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "postcss.config.mjs",
        "apps/**",
        "packages/**"
      ]
    }
  }
}
