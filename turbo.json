{
	"$schema": "https://v2-11-7.turborepo.dev/schema.json",
	"agentGuidance": false,
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["BIFROST_URL"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!src/**/__tests__/**",
				"!*.md",
				"$TURBO_ROOT$/.browserslistrc",
				"$TURBO_ROOT$/postcss.config.mjs",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/tsconfig.nextjs.json",
				"$TURBO_ROOT$/vitest.shared.ts"
			],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"transit": {
			"dependsOn": ["^transit"],
			"inputs": ["src/**", "!src/**/__tests__/**", "package.json"]
		},
		"check-types": {
			"dependsOn": ["transit"],
			"inputs": [
				"src/**",
				"app/**",
				"scripts/**",
				"*.ts",
				"tsconfig.json",
				"tsconfig.scripts.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/tsconfig.nextjs.json"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"docs:build": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"!src/**/__tests__/**",
				"!src/__benchmarks__/**",
				"tailwind.css",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json"
			],
			"outputs": ["src/docs/dist/**"]
		},
		"test:docs-build": {
			"dependsOn": ["docs:build"],
			"inputs": [
				"src/docs/dist/**",
				"src/__tests__/docs-build/**",
				"scripts/docs-server.ts",
				"vitest.docs-build.config.ts"
			]
		},
		"docs:bench": {
			"dependsOn": ["docs:build"],
			"cache": false
		},
		"lint": {
			"inputs": [
				"src/**",
				"app/**",
				"*.ts",
				"*.json",
				"$TURBO_ROOT$/biome.json",
				"$TURBO_ROOT$/.biome/plugins/**"
			]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"app/**",
				"vitest.config.ts",
				"$TURBO_ROOT$/vitest.shared.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"docs/*.md",
				"package.json"
			]
		},
		"test:compiler": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"vitest.config.ts",
				"vitest.compiler.config.ts",
				"vitest.compiler.preset.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"package.json"
			]
		},
		"test:browser": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"vitest.browser.config.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json"
			]
		},
		"test:changed": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"//#knip": {
			"inputs": [
				"knip.json",
				"package.json",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml",
				"postcss.config.mjs",
				"vitest.shared.ts",
				"apps/**",
				"packages/**"
			]
		}
	}
}
