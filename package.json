{
	"name": "midgard",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "hlidskjalf",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check-types": "turbo run check-types",
		"knip": "knip",
		"check": "turbo run lint knip && base=$(git merge-base HEAD origin/main) && TURBO_SCM_BASE=$base turbo run check-types test:changed test:workspace --affected",
		"test": "turbo run test",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"knip": "^6.26.0",
		"lefthook": "^2.1.10",
		"turbo": "2.11.11"
	},
	"packageManager": "pnpm@12.20.0",
	"dependencies": {
		"hlidskjalf": "^0.4.5"
	}
}
