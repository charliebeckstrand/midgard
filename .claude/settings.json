{
	"enabledMcpjsonServers": ["playwright", "next-devtools", "chrome-devtools", "context7"],
	"permissions": {
		"allow": ["Bash(mkdir:*)"]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
						"async": true
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/biome-format.sh"
					}
				]
			}
		]
	}
}
