{
	"enabledMcpjsonServers": [
		"playwright",
		"next-devtools",
		"chrome-devtools",
		"context7",
		"digitalocean"
	],
	"permissions": {
		"allow": ["Bash(mkdir:*)", "Bash(pnpm gate)"],
		"deny": [
			"mcp__digitalocean__apps-create-app-from-spec",
			"mcp__digitalocean__apps-delete",
			"mcp__digitalocean__apps-update"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
						"async": true
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/biome-format.sh"
					}
				]
			}
		]
	}
}
