# The image recipe for the migrate job of an app with a database. The job runs
# `db/migrate.sh` of the app, which applies `db/schema.sql` with `psql`, so the
# image needs no Node and no install. The spec in `.do/app.yaml` sets `APP`.
# Build it locally with:
#
#   docker build --file Dockerfile.migrate --build-arg APP=places .

# Keep the same major version as the managed cluster.
FROM postgres:18-alpine
ARG APP
WORKDIR /app
COPY apps/${APP}/db/ ./
USER postgres
CMD ["sh", "migrate.sh"]
