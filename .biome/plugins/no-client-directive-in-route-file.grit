language js

// A route file renders on the server unless it opts out, and `'use client'`
// on it moves its whole subtree to the client (CONVENTIONS §2.2). Keep the
// directive on the interactive leaf, as a `client.tsx` beside the page.
//
// The plugin matches the directive node, not file text, so a mention in a
// comment or a string is not a violation.
//
// Reach is the `includes` beside this plugin in `biome.json`: the page,
// layout, template, loading, not-found, and default files of each app. It
// leaves out `error.tsx` and `global-error.tsx`, because Next.js requires the
// directive there.
JsDirective() as $directive where {
	$directive <: r"['\"]use client['\"];?",
	register_diagnostic(
		span = $directive,
		message = "keep `'use client'` off the route file: move the interactive subtree to a `client.tsx` leaf, so the route stays server-rendered"
	)
}
