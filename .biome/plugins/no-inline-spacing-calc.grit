language js

// The ring-compensated formula `calc(--spacing(v)-1px)` lives in the ring
// utilities of `core/density/utilities.ts`. A class reaches it
// through `p-ring-*`, `px-ring-*`, `py-ring-*`, `ps-ring-*`, `pe-ring-*`,
// `ms-ring-*`, `me-ring-*`, and `rounded-ring-*`, with each variant, and
// through the stepped forms, such as `density-px-ring-[1,1.5,2]`.
//
// The plugin matches the formula in a string, a JSX string, or a template
// chunk. A mention in a comment is not a violation.
//
// Reach is the `includes` beside this plugin in `biome.json`: the recipe,
// component, module, primitive, and layout layers of `ui`, minus tests and
// benchmarks.
or { JsStringLiteralExpression(), JsxString(), JsTemplateChunkElement() } as $class where {
	$class <: r"[\s\S]*calc\(--spacing\([\s\S]*",
	register_diagnostic(
		span = $class,
		message = "reach the ring-compensated spacing through a ring utility (`px-ring-2`, …), not an inline `calc(--spacing(...))`"
	)
}
