language js

// The grid's engine boundary (CONVENTIONS.md §10.7). TanStack keeps one core
// table, and its rows and columns, for the life of a grid, and their reads are
// live. The React Compiler caches a read on the identity of its inputs.
// `use-grid-table.ts` is therefore the one module that reads the table during
// render, and the `engine` folder holds the helpers it calls. Every other module gets values and actions from the boundary, and
// takes no value from `@tanstack/react-table`.
//
// The engine is `@tanstack/react-table`, each of its subpath entries (such as
// `static-functions`), and `@tanstack/table-core`, which it re-exports.
//
// An `import type`, or a named import whose every specifier is `type`, carries
// no value, so it is exempt.
//
// Reach is the `includes` beside this plugin in `biome.json`: the `ui` source,
// minus the boundary module, the `engine` folder, tests, and benchmarks.
`import $clause from $source` as $import where {
	$source <: r"['\"]@tanstack/(?:react-table|table-core)(?:/[^'\"]*)?['\"]",
	not $import <: r"import\s+type\b[\s\S]*",
	not $import <: r"import\s*\{\s*type\s[^,}]*(?:,\s*type\s[^,}]*)*,?\s*\}[\s\S]*",
	register_diagnostic(
		span = $import,
		message = "take no value from `@tanstack/react-table` outside the grid's engine boundary: read the table in `use-grid-table.ts` or `engine/`, and give render code values and actions"
	)
}
