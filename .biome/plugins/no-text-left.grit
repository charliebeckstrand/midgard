language js

// A start alignment is `text-start`, not `text-left`. The two render the same
// in a left-to-right layout. In a right-to-left layout, `text-left` aligns the
// text to the inline end. Most sites set the alignment on a `<button>`, whose
// default centers its text, so the class only restores the start alignment.
//
// The plugin matches the class in a string, a JSX string, or a template
// chunk. A mention in a comment is not a violation. The one physical site,
// the `align` map of `kata/markdown`, carries a suppression with its reason.
//
// Reach is the `includes` beside this plugin in `biome.json`: each `ui` layer
// that spells Tailwind classes, minus tests and benchmarks.
or { JsStringLiteralExpression(), JsxString(), JsTemplateChunkElement() } as $class where {
	$class <: r"[\s\S]*\btext-left\b[\s\S]*",
	register_diagnostic(
		span = $class,
		message = "align to the start with `text-start`: `text-left` aligns to the inline end in a right-to-left layout"
	)
}
