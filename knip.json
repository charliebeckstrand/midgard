{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [".mcp-servers/**"],
	"ignoreUnresolved": ["next"],
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": ["postcss.config.mjs"]
		},
		"apps/*": {
			"entry": ["next.config.{js,ts,mjs}"],
			"ignoreDependencies": ["@tailwindcss/postcss"]
		},
		"packages/*": {
			"entry": ["src/**/index.ts"]
		},
		"packages/ui": {
			"entry": [
				"src/**/index.ts",
				"src/__tests__/**/setup/*.ts",
				"src/docs/react-router.config.ts",
				"src/docs/app/**/*.{ts,tsx}",
				"src/docs/fixtures/main.tsx",
				"src/docs/fixtures/app.css",
				"src/docs/fixtures/sheets/*.tsx",
				"vite.fixtures.config.ts",
				"src/core/density/variants.ts",
				"src/core/density/utilities.ts",
				"src/core/touch/base.ts"
			]
		}
	}
}
