{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreUnresolved": ["next"],
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": ["postcss.config.mjs"]
		},
		"apps/*": {
			"ignoreDependencies": ["@tailwindcss/postcss"]
		},
		"packages/*": {
			"entry": ["src/**/index.ts"]
		},
		"packages/ui": {
			"entry": [
				"src/**/index.ts",
				"src/__tests__/**/setup/*.ts",
				"src/docs/react-router.config.ts",
				"src/docs/vite.config.ts",
				"src/docs/app/**/*.{ts,tsx}",
				"src/docs/pages/**/index.tsx",
				"src/docs-legacy/react-router.config.ts",
				"src/docs-legacy/app/**/*.{ts,tsx}",
				"src/docs-legacy/demos/*/*.tsx",
				"src/docs-legacy/demos/*/*/index.tsx",
				"src/docs/fixtures/main.tsx",
				"src/docs/fixtures/app.css",
				"vite.docs-legacy.config.ts",
				"vite.fixtures.config.ts",
				"src/core/density/variants.ts",
				"src/core/density/utilities.ts",
				"src/core/touch/base.ts",
				"src/core/scroll/fade.ts"
			]
		}
	}
}
