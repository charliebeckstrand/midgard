{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": ["postcss.config.mjs"]
		},
		"apps/*": {
			"ignoreDependencies": ["@tailwindcss/postcss"],
			"ignoreIssues": {
				"**/components/*/index.ts": ["types"]
			}
		},
		"packages/*": {
			"entry": ["src/**/index.ts"]
		},
		"packages/ui": {
			"entry": [
				"src/**/index.ts",
				"src/__tests__/**/setup/*.ts",
				"src/docs/react-router.config.ts",
				"src/docs/vite.config.ts",
				"src/docs/app/**/*.{ts,tsx}",
				"src/docs/pages/**/index.tsx",
				"src/docs/kit/localize.tsx",
				"src/core/density/variants.ts",
				"src/core/density/utilities.ts",
				"src/core/touch/base.ts",
				"src/core/scheme/base.ts",
				"src/core/motion/variants.ts",
				"src/core/sidebar/variants.ts",
				"src/core/surfaces/variants.ts",
				"src/core/scroll/fade.ts",
				"src/core/panel/base.ts"
			]
		}
	}
}
