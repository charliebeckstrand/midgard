# The image recipe for the docs site of `ui`, a static site. App Platform builds
# this image and serves the files at `/app/packages/ui/src/docs/dist` in it. The
# spec in `.do/app.yaml` names that directory. Build it locally with:
#
#   docker build --file Dockerfile.docs .
#
# The stages follow the Dockerfile of the Next apps.

ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-alpine AS base
# Keep the same version as the `packageManager` field of the root `package.json`.
RUN npm install --global pnpm@12.5.1
WORKDIR /app

FROM base AS prune
COPY . .
# Keep the same version as the `turbo` dependency of the root `package.json`.
RUN pnpm dlx turbo@2.11.2 prune ui --docker

FROM base AS build
COPY --from=prune /app/out/json/ ./
# The install scripts of the tree are the `prepare` of the root and the
# `postinstall` of lefthook, which install git hooks. The image has no git, so
# skip the scripts. An environment variable, not a flag, because a later `pnpm`
# command can run an install of its own: on App Platform, `pnpm turbo` ran one
# and failed on `lefthook install`. A script that a command names still runs.
ENV pnpm_config_ignore_scripts=true
RUN pnpm install --frozen-lockfile
COPY --from=prune /app/out/full/ ./
# `turbo prune` copies the workspaces, not the shared configs at the root.
COPY tsconfig.base.json postcss.config.mjs .browserslistrc ./
RUN pnpm turbo run docs:build --filter=ui
