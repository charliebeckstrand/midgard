# The image recipe for the docs site of `ui`. App Platform builds this image
# and runs the server of the docs build in it (`packages/ui/scripts/docs-server.ts`).
# The server sends the HTML of each page in the locale of the request. Build
# and run it locally with:
#
#   docker build --file Dockerfile.docs --tag docs .
#   docker run --publish 8080:8080 docs
#
# The stages follow the Dockerfile of the Next apps.

ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-alpine AS base
# Keep the same version as the `packageManager` field of the root `package.json`.
# `dockerfile-pin-boundary.test.ts` in ui checks it.
RUN npm install --global pnpm@12.8.1
WORKDIR /app

FROM base AS prune
COPY . .
# Keep the same version as the turbo that `pnpm-lock.yaml` installs for the
# root package. `dockerfile-pin-boundary.test.ts` in ui checks it.
RUN pnpm dlx turbo@2.11.7 prune ui --docker

FROM base AS build
COPY --from=prune /app/out/json/ ./
# The install scripts of the tree are the `prepare` of the root and the
# `postinstall` of lefthook, which install git hooks. The image has no git, so
# skip the scripts. An environment variable, not a flag, because a later `pnpm`
# command can run an install of its own: on App Platform, `pnpm turbo` ran one
# and failed on `lefthook install`. A script that a command names still runs.
ENV pnpm_config_ignore_scripts=true
RUN pnpm install --frozen-lockfile
COPY --from=prune /app/out/full/ ./
# `turbo prune` copies the workspaces, not the shared configs at the root.
COPY tsconfig.base.json postcss.config.mjs .browserslistrc ./
RUN pnpm turbo run docs:build --filter=ui
RUN pnpm --filter ui docs:build-server

# The run stage holds only the pages and the server as one JavaScript file,
# with no `node_modules`. The server finds the pages at `src/docs/dist/client`
# from its own folder, so the stage keeps the layout of the package.
FROM node:${NODE_VERSION}-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
# The service of `.do/app.yaml` sends its requests to this port.
ENV HOST=0.0.0.0
ENV PORT=8080
COPY --from=build --chown=node:node /app/packages/ui/src/docs/dist/client ./src/docs/dist/client
COPY --from=build --chown=node:node /app/packages/ui/src/docs/dist/docs-server/docs-server.js ./scripts/
USER node
EXPOSE 8080
CMD ["node", "scripts/docs-server.js"]
